# Provider API Keys (set these in Vercel Environment Variables - Server Only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: Custom provider URLs (Server Only)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_URL=https://api.anthropic.com/v1

# Optional: Model selection
GOOGLE_MODEL=gemini-1.5-flash

# App metadata (can be used by client-side code)
NEXT_PUBLIC_APP_NAME=Oros Ai
